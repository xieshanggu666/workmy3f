# ===== 三服务（collector / archive / replay）环境配置样板 =====

# —— 端口 ——
COLLECTOR_PORT=7101
ARCHIVE_PORT=7102
REPLAY_PORT=7103

# —— 服务间地址 ——
ARCHIVE_URL=http://127.0.0.1:7102

# —— 数据目录（事件日志 / outbox；生产挂持久卷）——
COLLECTOR_DATA=./data/collector
ARCHIVE_DATA=./data/archive

# —— 真实调度域写入令牌（realm=real 的服务间鉴权；演练域 wg:* 不需要）——
REAL_REALM_TOKEN=change-me-in-production

# —— 采集转发 ——
FORWARD_TIMEOUT_MS=3000
